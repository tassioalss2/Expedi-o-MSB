# Ambiente Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.env
backend/.env.txt

# Ambiente Node
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Sistema
.DS_Store
Thumbs.db
*.log

# Scripts de importação (contêm caminhos locais)
backend/importar_*.py
backend/migrar_*.py
# Exceção: este recebe os caminhos por argumento, não traz nenhum embutido, e é
# a única forma de carregar a base que alimenta Inteligência — fora do repo ele
# se perde e alguém reescreve o mesmo script no mês que vem.
!backend/importar_faturamento_itens.py

# Exports do D365 usados nas importações — têm cliente, receita e preço.
# Dado de negócio não vai para o repositório.
*.xlsx
*.xls
*.csv

# Backups de registros de producao: ficam fora do repositorio
backend/backup_*.json
